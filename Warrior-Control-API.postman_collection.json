{
  "info": {
    "_postman_id": "6ef0ad26-2c8c-48f4-a3e2-warrior-control-api",
    "name": "Tubelight Control API",
    "description": "Run requests in order. Get Observed IPv4 stores reported_ipv4. Bootstrap stores access_token and selects the first returned provider/country. device_id must match an active ClientAccess row in Django admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "reported_ipv4",
      "value": "127.0.0.1",
      "type": "string"
    },
    {
      "key": "device_id",
      "value": "stable-device-hash",
      "type": "string"
    },
    {
      "key": "app_version",
      "value": "1.6.1",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "provider_code",
      "value": "P1",
      "type": "string"
    },
    {
      "key": "country_code",
      "value": "US",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 - Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/healthz/",
        "description": "Confirms the Django service is running."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Service is healthy', () => pm.expect(pm.response.json().ok).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Get Observed IPv4",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/ip/",
        "description": "Stores the IPv4 observed by the server into reported_ipv4."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "if (data.ipv4) pm.collectionVariables.set('reported_ipv4', data.ipv4);"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Bootstrap",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reported_ipv4\": \"{{reported_ipv4}}\",\n  \"device_id\": \"{{device_id}}\",\n  \"app_version\": \"{{app_version}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/bootstrap/",
        "description": "Requires an active ClientAccess row matching reported_ipv4 + device_id. Stores access_token and the first provider/country returned by the server."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set('access_token', data.access_token || '');",
              "  const providers = data.catalog && data.catalog.providers || [];",
              "  if (providers.length) {",
              "    pm.collectionVariables.set('provider_code', providers[0].id);",
              "    if (providers[0].countries && providers[0].countries.length) pm.collectionVariables.set('country_code', providers[0].countries[0].id);",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - Download Proxy Country File",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "X-Device-ID",
            "value": "{{device_id}}",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/v1/proxies/{{provider_code}}/{{country_code}}/",
        "description": "Uses the short-lived bootstrap token. Source IP and X-Device-ID must match bootstrap."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.test('Catalog content returned', () => pm.expect(pm.response.json()).to.have.property('content'));"
            ]
          }
        }
      ]
    }
  ]
}
